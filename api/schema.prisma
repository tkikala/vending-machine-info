// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentType {
  COIN
  BANKNOTE
  GIROCARD
  CREDIT_CARD
}

enum UserRole {
  ADMIN
  OWNER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?  // Nullable for future SSO users
  name      String
  role      UserRole @default(OWNER)
  isActive  Boolean  @default(true)
  emailVerified Boolean @default(false)
  emailVerificationToken String? @unique
  emailVerificationExpires DateTime?
  stripeCustomerId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  machines  VendingMachine[]
  reviews   Review[]
  sessions  Session[]
  subscriptions Subscription[]
  claimsRequested MachineClaim[] @relation("ClaimsRequestedByUser")
  claimsDecided   MachineClaim[] @relation("ClaimsDecidedByUser")
  featuredListings FeaturedListing[]
  assignedLeads    Lead[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VendingMachine {
  id             String           @id @default(uuid())
  name           String
  location       String
  description    String?
  logo           String?          // Path to uploaded logo file
  coordinates    String?          // Google Maps coordinates (e.g., "52.5200,13.4050")
  isActive       Boolean          @default(true)
  ownerId        String
  owner          User             @relation(fields: [ownerId], references: [id])
  products       MachineProduct[]
  paymentMethods MachinePaymentMethod[]
  photos         Photo[]
  reviews        Review[]
  featured       FeaturedListing[]
  dailyStats     MachineDailyStats[]
  claims         MachineClaim[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
}

model Product {
  id          String           @id @default(uuid())
  name        String
  description String?
  photo       String?
  price       Float?           // Default price
  category    String?          // Product category (e.g., Snacks, Cigarettes, Cold drinks, Hot drinks)
  isAvailable Boolean          @default(true)
  machines    MachineProduct[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
}

model MachineProduct {
  id               String         @id @default(uuid())
  vendingMachineId String
  productId        String
  price            Float?         // Override price for this machine
  isAvailable      Boolean        @default(true)
  vendingMachine   VendingMachine @relation(fields: [vendingMachineId], references: [id], onDelete: Cascade)
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt

  @@unique([vendingMachineId, productId])
}

model PaymentMethodType {
  id          String   @id @default(uuid())
  type        PaymentType @unique
  name        String   // Human-readable name
  description String?
  icon        String?  // Icon representation
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  machines    MachinePaymentMethod[]
}

model MachinePaymentMethod {
  id                  String            @id @default(uuid())
  vendingMachineId    String
  paymentMethodTypeId String
  available           Boolean           @default(true)
  vendingMachine      VendingMachine    @relation(fields: [vendingMachineId], references: [id], onDelete: Cascade)
  paymentMethodType   PaymentMethodType @relation(fields: [paymentMethodTypeId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @default(now()) @updatedAt

  @@unique([vendingMachineId, paymentMethodTypeId])
}

model Photo {
  id               String           @id @default(uuid())
  url              String
  caption          String?
  fileType         String           @default("image") // "image" or "video"
  originalName     String?          // Original filename
  fileSize         Int?             // File size in bytes
  vendingMachineId String
  vendingMachine   VendingMachine   @relation(fields: [vendingMachineId], references: [id], onDelete: Cascade)
  createdAt        DateTime         @default(now())
}

model Review {
  id               String           @id @default(uuid())
  rating           Int
  comment          String
  isApproved       Boolean          @default(false)
  isHidden         Boolean          @default(false)
  reply            String?
  userId           String
  vendingMachineId String
  user             User             @relation(fields: [userId], references: [id])
  vendingMachine   VendingMachine   @relation(fields: [vendingMachineId], references: [id], onDelete: Cascade)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
} 

enum LeadStatus {
  PENDING
  ASSIGNED
  CONTACTED
  CLOSED
}

model Lead {
  id         String     @id @default(uuid())
  name       String
  email      String
  phone      String?
  venueName  String
  address    String
  message    String?
  status     LeadStatus @default(PENDING)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @default(now()) @updatedAt
  assignedTo String?
  assignee   User?      @relation(fields: [assignedTo], references: [id])
}

model FeaturedListing {
  id         String         @id @default(uuid())
  machineId  String
  userId     String
  startsAt   DateTime       @default(now())
  endsAt     DateTime
  createdAt  DateTime       @default(now())

  machine    VendingMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([machineId])
  @@index([userId])
}

model MachineDailyStats {
  id            String   @id @default(uuid())
  machineId     String
  date          DateTime
  views         Int      @default(0)
  clicksWebsite Int      @default(0)
  clicksPhone   Int      @default(0)

  machine       VendingMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([machineId, date])
  @@index([machineId])
}

enum Plan {
  STARTER
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

model Subscription {
  id                   String               @id @default(uuid())
  userId               String
  plan                 Plan
  status               SubscriptionStatus
  currentPeriodEnd     DateTime
  stripeSubscriptionId String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @default(now()) @updatedAt

  // Entitlements snapshot
  machineLimit         Int                 @default(10)
  featuredSlots        Int                 @default(1)

  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

model MachineClaim {
  id             String         @id @default(uuid())
  machineId      String
  requesterUserId String
  message        String?
  status         ClaimStatus    @default(PENDING)
  decidedByUserId String?
  decidedAt      DateTime?
  createdAt      DateTime       @default(now())

  machine        VendingMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  requester      User           @relation("ClaimsRequestedByUser", fields: [requesterUserId], references: [id], onDelete: Cascade)
  decidedBy      User?          @relation("ClaimsDecidedByUser", fields: [decidedByUserId], references: [id])

  @@index([machineId])
  @@index([requesterUserId])
}